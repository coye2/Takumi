<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Takumi</AssemblyName>
    <RootNamespace>Takumi.Desktop</RootNamespace>
    <ApplicationIcon>../../assets/takumi.ico</ApplicationIcon>
    <Version>1.5.1</Version>
    <FileVersion>1.5.1.0</FileVersion>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <Product>Takumi</Product>
    <Description>Takumi — a private AI workspace</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <!-- The SDK adds both UI frameworks. This host uses WinForms only. -->
  <Target Name="ExcludeUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
